{
  "name": "dsh-quote-annotation",
  "version": "1.1.0",
  "description": "Quote conversation text with optional annotations and send it to the model as structured reference context in DeepSeek Harness (DSH).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quote",
    "annotation",
    "selection",
    "reference",
    "context"
  ],
  "license": "MIT",
  "author": {
    "name": "stickyfinger7",
    "url": "https://github.com/stickyfinger7"
  },
  "homepage": "https://github.com/stickyfinger7/dsh-quote-annotation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stickyfinger7/dsh-quote-annotation.git"
  },
  "bugs": {
    "url": "https://github.com/stickyfinger7/dsh-quote-annotation/issues"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/host.js && node --check lib/client.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
